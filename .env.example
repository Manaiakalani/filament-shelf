# Copy this file to ".env" and fill it in. Keep .env private.

# Leave the shelf with no accounts and the first visit asks for a name, a username
# and a password. Or add accounts from the terminal with server/users.mjs.
# Optional. When set, the setup page asks for this before it creates the first account.
# Use it when the address is already reachable beyond your own Wi-Fi.
SETUP_KEY=

# Port on your computer.
HOST_PORT=3026

# 0.0.0.0 = other devices on your Wi-Fi can open it.
# 127.0.0.1 = this computer only, or a tunnel on the same machine.
BIND_ADDRESS=0.0.0.0

# Days a device stays signed in.
SESSION_DAYS=30

# Leave blank and the cookie follows the request (https through Cloudflare, http on Wi-Fi).
# Set false only when you are sure every visitor uses plain http.
COOKIE_SECURE=

# ---- Cloudflare Tunnel (optional) ----
# 1. Paste the tunnel token from Zero Trust → Networks → Tunnels.
# 2. Set TRUST_PROXY=cloudflare so sign-in limits use each visitor's real IP
#    and cookies are marked secure.
# 3. Set PUBLIC_ORIGIN to your address, e.g. https://filament.example.com
# 4. Start with:  docker compose --profile tunnel up -d --build
#
# Leave TUNNEL_TOKEN empty when a tunnel is already running on this machine.
# Point that tunnel at http://filament-shelf:8080, and set TRUST_PROXY and
# PUBLIC_ORIGIN here. Do not start a second tunnel container.
TUNNEL_TOKEN=
TRUST_PROXY=
PUBLIC_ORIGIN=
